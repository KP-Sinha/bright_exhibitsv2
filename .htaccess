# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Custom 404 Error Document
ErrorDocument 404 /404.html

# Disable MultiViews to avoid conflicts
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS and canonical non-www domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.brightexhibits\.in$ [NC]
  RewriteRule ^(.*)$ https://brightexhibits.in/$1 [L,R=301]

  # 2. Redirect direct requests for index.html to root /
  RewriteCond %{THE_REQUEST} \s/+(?:index\.html)?[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 3. Explicit redirects for known aliases/variations (e.g. /contactus/ -> /contact/)
  RewriteRule ^contactus/?$ /contact/ [R=301,L]
  RewriteRule ^contact-us/?$ /contact/ [R=301,L]
  RewriteRule ^aboutus/?$ /about/ [R=301,L]
  RewriteRule ^about-us/?$ /about/ [R=301,L]

  # 4. Redirect legacy .html requests directly to clean folder routes (e.g. /about.html -> /about/)
  # Exclude 404.html so the error document isn't redirected
  RewriteCond %{THE_REQUEST} \s/+(?!404\.html)(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+?)\.html$ /$1/ [R=301,L]

  # 5. Enforce trailing slash on existing directory requests (e.g. /about -> /about/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}/$1 -d [OR]
  RewriteCond %{REQUEST_URI} ^/(about|products|retail-displays|contact|large-format-printing|customized-creative-displays|signages|printing-collaterals|digital-display-solutions|digital-display-stand|display-products|government-turnkey-projects)$ [NC]
  RewriteRule ^(.+?)$ /$1/ [R=301,L]

</IfModule>
